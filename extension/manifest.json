{
  "manifest_version": 3,
  "name": "Arthur MDL WhatsApp Dispatcher",
  "version": "3.0.0",
  "description": "Zero-tab-bloat WhatsApp Web dispatcher for the UKRIDA MDL student payroll slip. Reuses exactly one WhatsApp Web tab for every student.",
  "browser_specific_settings": {
    "gecko": {
      "id": "arthur-mdl-dispatcher@local",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://api.whatsapp.com/*",
    "https://arthurfreelanceinquiries-alt.github.io/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*/*slip.html*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arthurfreelanceinquiries-alt.github.io/*",
        "*://*/*slip.html*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content_slip.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*",
        "https://api.whatsapp.com/*"
      ],
      "js": ["content_wa.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
